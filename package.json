{
  "name": "sigenic-partner-portal-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "start:tsx": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "nodemailer": "^8.0.9",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.1",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3"
  }
}
